<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="@drawable/widget_background"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_vol_panel"
            android:tint="#FFFFFFFF"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open volume panel" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#33FFFFFF"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_vol_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_vol_minus"
            android:tint="#FFFFFFFF"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volume down" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#33FFFFFF"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_vol_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_vol_plus"
            android:tint="#FFFFFFFF"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volume up" />

    </LinearLayout>

</FrameLayout>
